# VRM Meter Configuration Example
# Copy this file to .env to customize settings

# User & Group ID (adjust to match host directory permissions for ./data)
# PUID=1000
# PGID=1000

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Database Configuration (SQLite)
# DB_URL=sqlite+aiosqlite:///data/vrmmeter.db

# Victron VRM API (Optional fallback; can also be configured via Web UI Settings)
# VRM_API_BASE_URL=https://vrmapi.victronenergy.com/v2
# VRM_API_TOKEN=your_vrm_api_token_here

# Scheduler Settings
SYNC_INTERVAL_MINUTES=30
SCHEDULER_ENABLED=true
